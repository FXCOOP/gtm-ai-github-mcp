# GitHub fine-grained PAT scoped to FXCOOP/gtm-ai-intelligence-hub.
# Required permissions:
#   - Contents: Read and write
#   - Metadata: Read
GITHUB_TOKEN=ghp_replace_me

# Target dashboard repo.
GITHUB_OWNER=FXCOOP
GITHUB_REPO=gtm-ai-intelligence-hub
GITHUB_BRANCH=main

# Long random string. Required on every MCP request as either:
#   Authorization: Bearer <secret>
#   x-mcp-secret: <secret>
MCP_SHARED_SECRET=replace_with_long_random_string
